{
  "Supplier": {
    "display_name": "供应商",
    "table_name": "supplier",
    "description": "SRM 系统管理的供应商主数据，含结算方式与冻结状态",
    "properties": {
      "supplier_code": {
        "display_name": "供应商编码",
        "description": "SRM 系统供应商唯一编码",
        "data_type": "STRING",
        "is_primary": true
      },
      "supplier_name": {
        "display_name": "供应商名称",
        "description": "供应商营业执照全称",
        "data_type": "STRING",
        "is_primary": false
      },
      "settlement_type": {
        "display_name": "结算方式",
        "description": "与供应商约定的付款周期",
        "data_type": "STRING",
        "is_primary": false
      },
      "frozen_flag": {
        "display_name": "冻结标记",
        "description": "true=冻结（停止对账与付款）；false=正常",
        "data_type": "BOOLEAN",
        "is_primary": false
      },
      "create_time": {
        "display_name": "创建时间",
        "description": "供应商主数据创建时间",
        "data_type": "TIMESTAMP",
        "is_primary": false
      },
      "update_time": {
        "display_name": "更新时间",
        "description": "供应商主数据最近更新时间",
        "data_type": "TIMESTAMP",
        "is_primary": false
      },
      "total_delivery_amount": {
        "display_name": "供应商交货总额",
        "description": "该供应商所有合同下全部交货记录的交货金额合计（元，含税）；由规则「供应商交货总额」衍生",
        "data_type": "DECIMAL",
        "is_primary": false
      }
    },
    "links": {}
  },
  "PurchaseContract": {
    "display_name": "采购合同",
    "table_name": "purchase_contract",
    "description": "与供应商签署的采购合同，记录金额与履约状态",
    "properties": {
      "contract_nr": {
        "display_name": "采购合同号",
        "description": "SRM 合同唯一编号",
        "data_type": "STRING",
        "is_primary": true
      },
      "contract_amount": {
        "display_name": "合同总金额",
        "description": "合同含税总金额（元）",
        "data_type": "DECIMAL",
        "is_primary": false
      },
      "sign_date": {
        "display_name": "签约日期",
        "description": "合同签署日期",
        "data_type": "DATE",
        "is_primary": false
      },
      "status": {
        "display_name": "合同状态",
        "description": "生效=正常履约；终止=到期或提前终止；作废=签署后取消",
        "data_type": "STRING",
        "is_primary": false
      },
      "supplier_code": {
        "display_name": "签约供应商",
        "description": "合同签约方的供应商编码",
        "data_type": "STRING",
        "is_primary": false
      }
    },
    "links": {
      "supplier": "Supplier"
    }
  },
  "DeliveryRecord": {
    "display_name": "交货记录",
    "table_name": "delivery_record",
    "description": "WMS 记录的每次交货明细，挂在采购合同下",
    "properties": {
      "delivery_nr": {
        "display_name": "交货单号",
        "description": "WMS 交货单唯一编号",
        "data_type": "STRING",
        "is_primary": true
      },
      "delivery_qty": {
        "display_name": "交货数量",
        "description": "本次交货件数",
        "data_type": "DOUBLE",
        "is_primary": false
      },
      "delivery_amount": {
        "display_name": "交货金额",
        "description": "本次交货金额（元，含税）",
        "data_type": "DECIMAL",
        "is_primary": false
      },
      "delivery_date": {
        "display_name": "交货日期",
        "description": "实际到货日期",
        "data_type": "DATE",
        "is_primary": false
      },
      "contract_nr": {
        "display_name": "关联合同",
        "description": "本次交货所属采购合同",
        "data_type": "STRING",
        "is_primary": false
      }
    },
    "links": {
      "purchase_contract": "PurchaseContract"
    }
  },
  "ReconciliationStatement": {
    "display_name": "对账单",
    "table_name": "reconciliation_statement",
    "description": "FIM 财务系统按供应商按月生成的对账单，记录发票与对账金额",
    "properties": {
      "recon_nr": {
        "display_name": "对账单号",
        "description": "FIM 对账单唯一编号",
        "data_type": "STRING",
        "is_primary": true
      },
      "recon_period": {
        "display_name": "对账期间",
        "description": "对账月份，格式 yyyy-MM",
        "data_type": "STRING",
        "is_primary": false
      },
      "invoice_amount": {
        "display_name": "发票金额",
        "description": "供应商本期开具发票总额（元）",
        "data_type": "DECIMAL",
        "is_primary": false
      },
      "reconciled_amount": {
        "display_name": "已对账金额",
        "description": "双方核对一致确认的金额（元）",
        "data_type": "DECIMAL",
        "is_primary": false
      },
      "status": {
        "display_name": "对账状态",
        "description": "open=对账中；confirmed=双方确认；disputed=存在争议",
        "data_type": "STRING",
        "is_primary": false
      },
      "create_time": {
        "display_name": "创建时间",
        "description": "对账单创建时间",
        "data_type": "TIMESTAMP",
        "is_primary": false
      },
      "supplier_code": {
        "display_name": "对账供应商",
        "description": "本对账单对应的供应商",
        "data_type": "STRING",
        "is_primary": false
      },
      "recon_diff_amount": {
        "display_name": "对账差异金额",
        "description": "发票金额 − 已对账金额（元）；由规则「对账差异金额」衍生",
        "data_type": "DECIMAL",
        "is_primary": false
      },
      "recon_diff_rate": {
        "display_name": "对账差异率",
        "description": "差异金额 ÷ 发票金额（比率）；由规则「对账差异率」衍生",
        "data_type": "DECIMAL",
        "is_primary": false
      }
    },
    "links": {
      "supplier": "Supplier"
    }
  }
}