{
  "Project": {
    "display_name": "项目",
    "table_name": "project",
    "description": "机型/产品线，需求和 BOM 的挂载主体（如 P-Z9/Z9、P-Z10 仅风险 BOM、P-X8 历史停产）",
    "properties": {
      "project_id": {
        "display_name": "项目ID",
        "description": "项目唯一编号（如 P-Z9）",
        "data_type": "STRING",
        "is_primary": true
      },
      "project_code": {
        "display_name": "项目编码",
        "description": "系统编码（如 100-Z9001）",
        "data_type": "STRING",
        "is_primary": false
      },
      "model_name": {
        "display_name": "机型",
        "description": "机型名称（如 Z9/Z9S/Z10/X8）",
        "data_type": "STRING",
        "is_primary": false
      },
      "stage": {
        "display_name": "项目阶段",
        "description": "量产 MP=量产；NPI-DVT=新品验证；EOL=停产（历史）",
        "data_type": "STRING",
        "is_primary": false
      },
      "bom_status_desc": {
        "display_name": "BOM状态说明",
        "description": "该项目当前 BOM 版本状态快照描述（如 标准 v3.2；换料后主板 v2.2）",
        "data_type": "STRING",
        "is_primary": false
      },
      "purpose_desc": {
        "display_name": "用途说明",
        "description": "主线/补充测试/历史案例包等，历史案例包不与当前混算",
        "data_type": "STRING",
        "is_primary": false
      }
    },
    "links": {}
  },
  "Material": {
    "display_name": "物料",
    "table_name": "material",
    "description": "最小跟踪单位（WiFi 模组、SoC 等），用于汇总与库存跟踪",
    "properties": {
      "material_code": {
        "display_name": "物料编码",
        "description": "物料唯一编码（如 300-W6A01、H-WIFI-OLD、UNIT-M）",
        "data_type": "STRING",
        "is_primary": true
      },
      "material_name": {
        "display_name": "物料名称",
        "description": "如 WiFi5/WiFi6/SoC",
        "data_type": "STRING",
        "is_primary": false
      },
      "base_uom": {
        "display_name": "基本单位",
        "description": "物料基本计量单位（颗/盒）",
        "data_type": "STRING",
        "is_primary": false
      },
      "unit_cost": {
        "display_name": "演示成本单价",
        "description": "固定演示成本（WiFi5 16 元/颗、WiFi6 20 元/颗），与供应商报价区间分别记录，不代表真实报价",
        "data_type": "DECIMAL",
        "is_primary": false
      }
    },
    "links": {}
  },
  "UnitConversion": {
    "display_name": "单位换算",
    "table_name": "unit_conversion",
    "description": "已批准的计量单位换算关系（如 1盒=100颗）；移除换算依据后提示缺证，不得将 12 盒当作 12 颗",
    "properties": {
      "conversion_id": {
        "display_name": "换算关系ID",
        "description": "换算关系唯一编号",
        "data_type": "STRING",
        "is_primary": true
      },
      "material_id": {
        "display_name": "物料编码",
        "description": "换算适用的物料",
        "data_type": "STRING",
        "is_primary": false
      },
      "from_uom": {
        "display_name": "源单位",
        "description": "被换算单位（如 盒）",
        "data_type": "STRING",
        "is_primary": false
      },
      "to_uom": {
        "display_name": "目标单位",
        "description": "换算目标单位（如 颗，即基本单位）",
        "data_type": "STRING",
        "is_primary": false
      },
      "ratio": {
        "display_name": "换算比率",
        "description": "1 源单位 = ratio 目标单位（1盒=100颗）",
        "data_type": "DECIMAL",
        "is_primary": false
      },
      "approval_status": {
        "display_name": "批准状态",
        "description": "换算关系须为已批准才可参与计算",
        "data_type": "STRING",
        "is_primary": false
      },
      "evidence_status": {
        "display_name": "证据状态",
        "description": "complete=证据齐全；missing=换算依据被移除，缺证提示、不按零处理",
        "data_type": "STRING",
        "is_primary": false
      }
    },
    "links": {
      "material": "Material"
    }
  },
  "Supplier": {
    "display_name": "供应商",
    "table_name": "supplier",
    "description": "物料供应商（参考清单的整理维度；参考清单不等于采购订单，默认不外发）",
    "properties": {
      "supplier_id": {
        "display_name": "供应商编码",
        "description": "供应商唯一编码（如 V-WLINK）",
        "data_type": "STRING",
        "is_primary": true
      },
      "supplier_name": {
        "display_name": "供应商名称",
        "description": "供应商名称",
        "data_type": "STRING",
        "is_primary": false
      },
      "purchasing_group": {
        "display_name": "采购组",
        "description": "采购组编码（如 206）",
        "data_type": "STRING",
        "is_primary": false
      }
    },
    "links": {}
  },
  "BomLine": {
    "display_name": "BOM行",
    "table_name": "bom_line",
    "description": "机型结构清单行（标准/风险/维修 BOM），含版本、层级用量、损耗与生效日期；标准 BOM 与风险 BOM 分开比较，新旧替代料行不得在同一有效 BOM 中同时作为必需组件相加",
    "properties": {
      "line_id": {
        "display_name": "BOM行ID",
        "description": "行唯一编号（如 L-Z9-01、H-BOM-OLD-R1）",
        "data_type": "STRING",
        "is_primary": true
      },
      "bom_type": {
        "display_name": "BOM类型",
        "description": "standard=标准 BOM；risk=风险 BOM（NPI 预批）；maintenance=维修 BOM（售后）",
        "data_type": "STRING",
        "is_primary": false
      },
      "version": {
        "display_name": "BOM版本",
        "description": "所属 BOM 版本（如 整机 v3.2、主板 v2.2、风险 v0.9）",
        "data_type": "STRING",
        "is_primary": false
      },
      "parent_material_id": {
        "display_name": "父项物料编码",
        "description": "父项物料（如 100-Z9001 整机、200-Z9PCB 主板）；不进 links（双链取舍见 assumptions A7）",
        "data_type": "STRING",
        "is_primary": false
      },
      "material_id": {
        "display_name": "子项物料编码",
        "description": "BOM 行的子项物料（如 300-W6A01 WiFi6），links 主关联；父项引用以属性承载",
        "data_type": "STRING",
        "is_primary": false
      },
      "project_id": {
        "display_name": "所属项目ID",
        "description": "行所属项目（由项目表\"BOM 状态\"关联推断，附录行表未单列）",
        "data_type": "STRING",
        "is_primary": false
      },
      "qty_per": {
        "display_name": "BOM行用量",
        "description": "该行子项用量原始值，单位一致后参与计算",
        "data_type": "DECIMAL",
        "is_primary": false
      },
      "base_qty": {
        "display_name": "BOM基准数量",
        "description": "行用量对应的父项基准数量（如 1/1）",
        "data_type": "DECIMAL",
        "is_primary": false
      },
      "yield_rate": {
        "display_name": "良率",
        "description": "该层良率，仅明确适用的层级计入；没有损耗的层级取 1（主案例良率均设 1，多层损耗见测试五）",
        "data_type": "DOUBLE",
        "is_primary": false
      },
      "effective_from": {
        "display_name": "生效开始日期",
        "description": "行生效起始日期（如 2026-11-01 起）",
        "data_type": "DATE",
        "is_primary": false
      },
      "effective_to": {
        "display_name": "生效截止日期",
        "description": "行生效截止日期（旧 WiFi 行至 2026-10-31，V1 更新后的有效期）",
        "data_type": "DATE",
        "is_primary": false
      },
      "known_at": {
        "display_name": "known_at（可见数据版本）",
        "description": "记录可见时间，取值为数据版本号（V0/V1/V0之前）；版本机制见 DataVersion",
        "data_type": "STRING",
        "is_primary": false
      },
      "evidence_status": {
        "display_name": "证据状态",
        "description": "complete=明细齐全；missing=缺证版本移除行明细后标记缺失，依赖它的推导同步不可验证",
        "data_type": "STRING",
        "is_primary": false
      },
      "standard_usage": {
        "display_name": "标准用量",
        "description": "标准 = BOM 行用量 ÷ BOM 基准数量（derived）",
        "data_type": "DECIMAL",
        "is_primary": false
      }
    },
    "links": {
      "material": "Material",
      "project": "Project"
    }
  },
  "EcnRecord": {
    "display_name": "工程变更记录",
    "table_name": "ecn_record",
    "description": "工程变更（ECN）记录（如 Z9 换料 ECN：WiFi5 退出、WiFi6 引入、11-01 生效）；缺证版本保留引用编号但批准文件与变更后 BOM 明细标记缺失",
    "properties": {
      "ecn_id": {
        "display_name": "工程变更ID",
        "description": "变更唯一编号（历史案例如 H-ECN-01；主案例编号文档未给出，见 OQ-10）",
        "data_type": "STRING",
        "is_primary": true
      },
      "project_id": {
        "display_name": "所属项目ID",
        "description": "变更所属项目",
        "data_type": "STRING",
        "is_primary": false
      },
      "change_desc": {
        "display_name": "变更内容",
        "description": "变更描述（换料：WiFi5 退出、WiFi6 引入）",
        "data_type": "STRING",
        "is_primary": false
      },
      "publish_date": {
        "display_name": "发布日期",
        "description": "变更发布日期（V1=2026-09-29）",
        "data_type": "DATE",
        "is_primary": false
      },
      "effective_date": {
        "display_name": "生效日期",
        "description": "变更生效日期（2026-11-01）",
        "data_type": "DATE",
        "is_primary": false
      },
      "approval_status": {
        "display_name": "批准状态",
        "description": "approved=已批准；pending=待批准",
        "data_type": "STRING",
        "is_primary": false
      },
      "evidence_status": {
        "display_name": "证据状态",
        "description": "complete=批准文件与变更后 BOM 明细齐全；missing=引用编号保留但批准文件缺失，依赖推导不可验证",
        "data_type": "STRING",
        "is_primary": false
      },
      "known_at": {
        "display_name": "known_at（可见数据版本）",
        "description": "记录可见数据版本（如 V1）",
        "data_type": "STRING",
        "is_primary": false
      }
    },
    "links": {
      "project": "Project"
    }
  },
  "Demand": {
    "display_name": "需求",
    "table_name": "demand",
    "description": "各项目需要数量与日期（订单/MPS/预测/售后维修），覆盖关系明确；同 ID 新版本替换旧版本、不追加计数",
    "properties": {
      "demand_id": {
        "display_name": "需求ID",
        "description": "需求唯一编号（如 DEM-Z9-NOV、ORD-Z9-NOV、FCST-Z9-NOV）",
        "data_type": "STRING",
        "is_primary": true
      },
      "demand_version": {
        "display_name": "需求版本",
        "description": "同一需求的版本（v1/v2），v2 替换 v1 而非追加；与 demand_id 构成复合主键",
        "data_type": "STRING",
        "is_primary": true
      },
      "project_id": {
        "display_name": "项目ID",
        "description": "需求归属项目",
        "data_type": "STRING",
        "is_primary": false
      },
      "need_date": {
        "display_name": "需要日期",
        "description": "物料需要可用的日期（非客户交货日期，如 2026-11-30）",
        "data_type": "DATE",
        "is_primary": false
      },
      "demand_qty": {
        "display_name": "需求数量",
        "description": "需求数量（台/件）",
        "data_type": "DECIMAL",
        "is_primary": false
      },
      "source_type": {
        "display_name": "需求来源",
        "description": "MPS=已确认生产计划；order=客户订单；forecast=早期预测；service=售后维修需求",
        "data_type": "STRING",
        "is_primary": false
      },
      "covered_by_demand_id": {
        "display_name": "被覆盖于需求ID",
        "description": "覆盖关系：本需求已包含于哪条需求（ORD-Z9-NOV covered_by=DEM-Z9-NOV）；无覆盖依据时不得仅凭来源优先级舍弃；以属性承载、不建 links（复合主键目标，见 assumptions A7 与 OQ-03）",
        "data_type": "STRING",
        "is_primary": false
      },
      "status": {
        "display_name": "需求状态",
        "description": "confirmed=已确认参与计算；superseded=已被新版本替换；reference=仅作参考（被替换的早期预测）",
        "data_type": "STRING",
        "is_primary": false
      },
      "known_at": {
        "display_name": "known_at（可见数据版本）",
        "description": "记录可见数据版本（V0/V3）",
        "data_type": "STRING",
        "is_primary": false
      },
      "package_id": {
        "display_name": "所属数据包ID",
        "description": "所属数据包（主案例/历史案例/补充测试互不混算）",
        "data_type": "STRING",
        "is_primary": false
      }
    },
    "links": {
      "project": "Project"
    }
  },
  "MaterialAuthorization": {
    "display_name": "物料授权",
    "table_name": "material_authorization",
    "description": "整机料号维度的供应商备料授权（对应卫国策备表口径）；授权仅是审批覆盖口径，不构成物理供给，不得因授权增加而新增供给；新版本替换旧版本",
    "properties": {
      "auth_id": {
        "display_name": "授权ID",
        "description": "授权记录唯一编号",
        "data_type": "STRING",
        "is_primary": true
      },
      "auth_version": {
        "display_name": "授权版本",
        "description": "授权版本（v1/v2），v2 覆盖并替换 v1；与 auth_id 构成复合主键",
        "data_type": "STRING",
        "is_primary": true
      },
      "material_id": {
        "display_name": "物料编码",
        "description": "被授权物料",
        "data_type": "STRING",
        "is_primary": false
      },
      "project_id": {
        "display_name": "授权对象项目ID",
        "description": "授权覆盖的整机项目/产品",
        "data_type": "STRING",
        "is_primary": false
      },
      "covered_qty": {
        "display_name": "授权覆盖量",
        "description": "授权覆盖的数量（如 v1 覆盖 10",
        "data_type": "DECIMAL",
        "is_primary": false
      },
      "approval_status": {
        "display_name": "批准状态",
        "description": "approved=已批准（10月1日批准）；pending=待批准",
        "data_type": "STRING",
        "is_primary": false
      },
      "effective_from": {
        "display_name": "生效开始日期",
        "description": "授权生效起始日期",
        "data_type": "DATE",
        "is_primary": false
      },
      "known_at": {
        "display_name": "known_at（可见数据版本）",
        "description": "记录可见数据版本",
        "data_type": "STRING",
        "is_primary": false
      },
      "package_id": {
        "display_name": "所属数据包ID",
        "description": "所属数据包",
        "data_type": "STRING",
        "is_primary": false
      }
    },
    "links": {
      "material": "Material",
      "project": "Project"
    }
  },
  "Supply": {
    "display_name": "供给记录",
    "table_name": "supply",
    "description": "物理供给条目（可用库存/质检冻结库存/已确认未收货订单/模拟采购）；质检冻结不参与供给单列待核查；模拟供给只存在于 SIM 情景、不得写入 FACT",
    "properties": {
      "supply_id": {
        "display_name": "供给ID",
        "description": "供给唯一编号（PS-1001/SIM-W6-9000/ST-R1）",
        "data_type": "STRING",
        "is_primary": true
      },
      "material_id": {
        "display_name": "物料编码",
        "description": "供给物料",
        "data_type": "STRING",
        "is_primary": false
      },
      "supply_type": {
        "display_name": "供给类型",
        "description": "available_stock=可用库存；frozen_stock=质检冻结库存；open_order=已确认未收货订单；simulated_purchase=模拟采购（仅 SIM）",
        "data_type": "STRING",
        "is_primary": false
      },
      "qty": {
        "display_name": "供给数量",
        "description": "供给数量（颗）",
        "data_type": "DECIMAL",
        "is_primary": false
      },
      "available_date": {
        "display_name": "可用或到货日",
        "description": "供给可用/确认到货日期；库存类取数据版本可见日（V0 映射见 assumptions A1）；未确定时缺省并由 evidence 语义约束",
        "data_type": "DATE",
        "is_primary": false
      },
      "restriction_desc": {
        "display_name": "限制说明",
        "description": "使用限制（如 仅按 A.4 临时许可使用/未获放行不参与供给/不能满足 11 月）",
        "data_type": "STRING",
        "is_primary": false
      },
      "po_id": {
        "display_name": "关联订单号",
        "description": "订单类供给指向的采购订单（库存类为空）",
        "data_type": "STRING",
        "is_primary": false
      },
      "scenario_tag": {
        "display_name": "情景标签",
        "description": "FACT=事实记录；SIM=模拟记录；事实与模拟分别保存，模拟供给不得写入 FACT",
        "data_type": "STRING",
        "is_primary": false
      },
      "package_id": {
        "display_name": "所属数据包ID",
        "description": "所属数据包（主案例/历史/测试包独立）",
        "data_type": "STRING",
        "is_primary": false
      },
      "known_at": {
        "display_name": "known_at（可见数据版本）",
        "description": "记录可见数据版本（六条供给均在 V0 可见）",
        "data_type": "STRING",
        "is_primary": false
      },
      "exclude_reason": {
        "display_name": "排除原因",
        "description": "不参与供给分配的原因（质检冻结：未获放行，单列待核查，不认定零风险或全额损失）",
        "data_type": "STRING",
        "is_primary": false
      }
    },
    "links": {
      "material": "Material",
      "po": "PurchaseOrder"
    }
  },
  "PurchaseOrder": {
    "display_name": "采购订单",
    "table_name": "purchase_order",
    "description": "采购订单承诺与取消/延期条款（未到货供给的订单侧）；取消权限、数量上限及延期条件须为已有书面模拟证据，不能在计算出结果后临时补设",
    "properties": {
      "po_id": {
        "display_name": "订单号",
        "description": "订单唯一编号（PO-R1；PS-3002 对应订单）",
        "data_type": "STRING",
        "is_primary": true
      },
      "material_id": {
        "display_name": "物料编码",
        "description": "订单物料",
        "data_type": "STRING",
        "is_primary": false
      },
      "order_qty": {
        "display_name": "订单数量",
        "description": "订单总量（如 8",
        "data_type": "DECIMAL",
        "is_primary": false
      },
      "cumulative_receipt_qty": {
        "display_name": "累计有效收货量",
        "description": "累计有效收货数量；明确为 0 与未导入不同（assumptions A4）",
        "data_type": "DECIMAL",
        "is_primary": false
      },
